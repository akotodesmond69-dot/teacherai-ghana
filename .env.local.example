# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# From Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY is needed in BOTH places: locally for the seed
# script, AND in your deployment platform's environment variables (Vercel,
# etc.) — the billing actions and Paystack webhook use it in production too.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# From platform.openai.com — only needed if you switch back to OpenAI
OPENAI_API_KEY=

# From aistudio.google.com (free, no credit card required) — this is what
# the app actually uses right now, see lib/ai/, lib/assistant/, lib/scheme/
GEMINI_API_KEY=

# From your Paystack Dashboard > Settings > API Keys & Webhooks.
# Test Secret Key works immediately, no business verification needed.
PAYSTACK_SECRET_KEY=

# The real URL Paystack should redirect back to after payment.
# Use http://localhost:3000 for local testing.
NEXT_PUBLIC_APP_URL=http://localhost:3000
